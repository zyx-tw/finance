FINANCE_DATA=/srv/finance
FINANCE_PORT=8080
FINANCE_ORIGIN=https://finance.zyx.tw
# The bearer token for importers and MCP clients, 32 characters or more.
FINANCE_TOKEN=<token>
# Claude sorts rows the built-in rules cannot place. Off when unset.
FINANCE_ANTHROPIC_KEY=<key>
# The banks' statement PDF passwords, comma separated, for POST /api/v1/statements (needs qpdf and poppler-utils).
FINANCE_PDF_PASSWORD=<password>,<card password>
# OCR for statements whose text pdftotext cannot read (CTBC). Off when the key is unset.
FINANCE_OCR_KEY=<llm.winlab.tw key>
# FINANCE_OCR_URL=https://llm.winlab.tw/v1
# FINANCE_OCR_MODEL=mineru-flash
OTEL_EXPORTER_OTLP_ENDPOINT=https://sensorium.zyx.tw
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
OTEL_SERVICE_NAME=finance
# carrel-deployd checks health on 127.0.0.1, so listen on every address.
FINANCE_HOSTNAME=0.0.0.0
